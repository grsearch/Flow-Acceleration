[Unit]
Description=Pump.fun Flow Acceleration research collector
Documentation=file:///opt/flow-acceleration/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/flow-acceleration
EnvironmentFile=/opt/flow-acceleration/.env
Environment=NODE_ENV=production
ExecStartPre=/usr/bin/test -s /opt/flow-acceleration/.env
ExecStart=/usr/bin/node /opt/flow-acceleration/src/index.js
Restart=always
RestartSec=5
# Signal the main process first so it can drain writes and stop its workers.
# A failed drain must remain visible; never escalate the stop to SIGKILL.
# With mixed + SendSIGKILL=no, surviving processes also prevent a new start.
TimeoutStopSec=180s
KillSignal=SIGTERM
KillMode=mixed
SendSIGKILL=no
StandardOutput=append:/opt/flow-acceleration/logs/out.log
StandardError=append:/opt/flow-acceleration/logs/err.log
SyslogIdentifier=flow-acceleration
LimitNOFILE=65536
UMask=0077
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
