# Stored on the server as /etc/flow-acceleration/backup-cos.env with mode 0600.
# Never commit real credentials.
FLOW_BACKUP_COS_SECRET_ID=
FLOW_BACKUP_COS_SECRET_KEY=
FLOW_BACKUP_COS_BUCKET=your-bucket-appid
FLOW_BACKUP_COS_REGION=your-region
FLOW_BACKUP_COS_ENDPOINT=cos.your-region.myqcloud.com
FLOW_BACKUP_COS_PREFIX=flow-acceleration/daily
FLOW_BACKUP_COS_THREADS=4
FLOW_BACKUP_EXPORT_TIMEOUT=2h
FLOW_BACKUP_UPLOAD_TIMEOUT=30m
FLOW_BACKUP_VERIFY_TIMEOUT=5m
FLOW_BACKUP_LOCAL_RETENTION_DAYS=2
FLOW_BACKUP_MAX_LOCAL_ARCHIVES=2
FLOW_BACKUP_MIN_FREE_GB=20
FLOW_BACKUP_ORPHAN_MAX_AGE_MINUTES=360
FLOW_BACKUP_LOG_LINES=20000
