# Pump.fun Flow Acceleration — full research capture + opt-in smart OPEN execution
# Primary Flow signal shadow — research only; it never sends a transaction.
# Copy this file to .env. Live transaction sending is disabled by default.

# Yellowstone / Helius LaserStream. Endpoints are ordered active then standby.
# Only one endpoint is subscribed at a time. Silicon Valley defaults to LAX -> SLC.
# Official regions include ewr, pitt, slc, lax, lon, fra, ams, tyo, and sgp.
FLOW_GRPC_ENDPOINTS=https://laserstream-mainnet-lax.helius-rpc.com,https://laserstream-mainnet-slc.helius-rpc.com
FLOW_GRPC_TOKEN=

# Rotate to the next endpoint after a disconnect or 15 seconds without transactions.
FLOW_STREAM_RECONNECT_MIN_MS=1000
FLOW_STREAM_RECONNECT_MAX_MS=30000
FLOW_STREAM_STALE_TIMEOUT_MS=15000
FLOW_STREAM_STALE_CHECK_MS=2000

# Existing deployment variables are also accepted as fallbacks:
# HELIUS_LASERSTREAM_ENDPOINTS=
# HELIUS_LASERSTREAM_TOKEN=
# HELIUS_API_KEY=
# ALLENHARK_GRPC_ENDPOINTS=
# ALLENHARK_GRPC_TOKEN=

# Global rolling buffer and Activity Wake-Up (last 5 seconds, any condition).
FLOW_BUFFER_MS=600000
FLOW_ACTIVITY_WINDOW_MS=5000
FLOW_ACTIVITY_MIN_VOLUME_SOL=3
FLOW_ACTIVITY_MIN_TX_COUNT=12
FLOW_ACTIVITY_MIN_UNIQUE_WALLETS=8

# Three consecutive 2-second windows.
FLOW_SIGNAL_WINDOW_MS=2000
FLOW_MIN_NET_W3_SOL=1
FLOW_MIN_NET_DELTA_SOL=0.1
FLOW_MIN_ACCEL_RATIO=1.2
FLOW_RATIO_FLOOR_SOL=0.05
# The primary and research-only shadow variants emit on their own false -> true edges.
# Keep live collection cooldown disabled; the backtester applies a separate 5s default cooldown.
FLOW_SIGNAL_COOLDOWN_MS=0
FLOW_CANDIDATE_IDLE_MS=15000

# Research labels and backtests use this same round-trip cost model.
# FLOW_DEFAULT_TRADING_COST_PCT remains a backward-compatible alias for platform fee.
FLOW_DEFAULT_TRADING_COST_PCT=1.4
FLOW_PLATFORM_FEE_PCT=1.4
FLOW_BUY_SLIPPAGE_PCT=0.3
FLOW_SELL_SLIPPAGE_PCT=0.3
FLOW_PRICE_IMPACT_PCT=0.2
FLOW_BASE_TX_FEE_SOL=0.00001
FLOW_PRIORITY_FEE_SOL=0.0005
FLOW_JITO_TIP_SOL=0
FLOW_FIXED_COST_SOL=0
FLOW_POSITION_SIZE_SOL=0.2
# Entry failures open no position; sell failures are modeled separately with exit retries.
FLOW_ENTRY_FAILURE_RATE_PCT=0
FLOW_ENTRY_FAILURE_COST_PCT=1
FLOW_LABEL_MAX_OBSERVATION_LAG_MS=2000

# Execution windows. Entry must be a pre-graduation Bonding Curve trade.
# Exit may be a later Bonding Curve or PumpSwap trade.
FLOW_BACKTEST_ENTRY_DELAY_MS=200
FLOW_BACKTEST_ENTRY_TIMEOUT_MS=2000
FLOW_BACKTEST_EXIT_DELAY_MS=200
FLOW_BACKTEST_EXIT_TIMEOUT_MS=5000
FLOW_BACKTEST_NO_EXIT_LOSS_PCT=100
FLOW_BACKTEST_SIGNAL_COOLDOWN_MS=5000
FLOW_BACKTEST_SINGLE_POSITION_PER_MINT=true

# Shared fallback for every Shadow strategy. Strategy-specific values below
# remain optional overrides. A legacy strategy-specific value of exactly 0.05
# inherits this new default during upgrade; other custom sizes remain explicit.
# Historical rows retain their recorded size/cost.
FLOW_SHADOW_DEFAULT_POSITION_SOL=1

# Primary Early shadow cohorts. These paths never sign or send transactions.
# Aggressive=3 SOL/3 buyers, balanced=the live 5/4 threshold, conservative=7/5.
# Exit: trailing stop active immediately at 7.5%, with a 60-second fallback.
# Retired negative-expectancy strategies stay off even if an old server .env
# still contains per-strategy =true values. Set this master override only for diagnosis.
FLOW_RETIRED_SHADOWS_ENABLED=false
# Large-sample negative cohorts stay off even if their old per-strategy switch
# remains true on an upgraded server. Set this only to reproduce old research.
FLOW_PROVEN_NEGATIVE_SHADOWS_ENABLED=false
FLOW_SIGNAL_SHADOW_ENABLED=false
FLOW_SIGNAL_SHADOW_POSITION_SOL=1
FLOW_SIGNAL_SHADOW_AGGRESSIVE_MIN_NETFLOW_W3_SOL=3
FLOW_SIGNAL_SHADOW_AGGRESSIVE_MIN_BUYERS_W3=3
FLOW_SIGNAL_SHADOW_CONSERVATIVE_MIN_NETFLOW_W3_SOL=7
FLOW_SIGNAL_SHADOW_CONSERVATIVE_MIN_BUYERS_W3=5
FLOW_SIGNAL_SHADOW_MAX_SIGNAL_AGE_MS=1500
FLOW_SIGNAL_SHADOW_ENTRY_DELAY_MS=200
FLOW_SIGNAL_SHADOW_ENTRY_TIMEOUT_MS=2000
FLOW_SIGNAL_SHADOW_EXIT_DELAY_MS=200
FLOW_SIGNAL_SHADOW_EXIT_TIMEOUT_MS=5000
FLOW_SIGNAL_SHADOW_MAX_ENTRY_JUMP_PCT=10
FLOW_SIGNAL_SHADOW_TRAILING_STOP_PCT=7.5
FLOW_SIGNAL_SHADOW_MAX_HOLD_MS=60000

# Direct Primary Flow Signal Shadow C. The first signal in each 30-second
# signal_episode_id is simulated once per exit cohort. All cohorts use the same
# first Bonding Curve trade at/after the 200ms entry delay and never send a transaction.
FLOW_FIRST_SHADOW_ENABLED=false
FLOW_FIRST_SHADOW_POSITION_SOL=1
FLOW_FIRST_SHADOW_MAX_SIGNAL_AGE_MS=1500
FLOW_FIRST_SHADOW_ENTRY_DELAY_MS=200
FLOW_FIRST_SHADOW_ENTRY_TIMEOUT_MS=2000
FLOW_FIRST_SHADOW_EXIT_DELAY_MS=200
FLOW_FIRST_SHADOW_EXIT_TIMEOUT_MS=5000
FLOW_FIRST_SHADOW_FIXED_HOLD_MS=5000
FLOW_FIRST_SHADOW_C75_TRAILING_STOP_PCT=7.5
FLOW_FIRST_SHADOW_C125_TRAILING_STOP_PCT=12.5
FLOW_FIRST_SHADOW_MAX_HOLD_MS=60000
FLOW_FIRST_SHADOW_BIG_WINNER_PCT=50

# Persistence: the COS-verified daily maintenance job keeps recent raw trades hot.
FLOW_DB_PATH=./data/flow-research.db
FLOW_RAW_RETENTION_HOURS=48
FLOW_ARCHIVE_DIR=./data/archive
FLOW_DB_FLUSH_MS=250
FLOW_DB_FLUSH_MAX=1000
# Heavy table counts run on a read-only worker; HTTP only reads this cached snapshot.
# Large production databases use a 15-minute interval to avoid continuous disk scans.
FLOW_DB_HEALTH_REFRESH_MS=900000
# One shared 15-minute replay is loaded once during startup and reused by Shadow suites.
FLOW_STARTUP_REPLAY_CACHE_MS=900000

# The COS export process never mutates or cleans the live database. Running the
# old external cleanup concurrently with a service restart can hold SQLite's
# write lock and cause a SQLITE_BUSY restart loop. Retention cleanup is now an
# explicit offline-maintenance action only; the daily timer leaves it disabled.
FLOW_RETENTION_CLEANUP_ENABLED=false
FLOW_RETENTION_HOT_RAW_HOURS=48
FLOW_RETENTION_BATCH_ROWS=25000
FLOW_RETENTION_MAX_ROWS_PER_RUN=5000000
FLOW_RETENTION_MAX_RUN_MS=2700000
FLOW_RETENTION_BATCH_PAUSE_MS=250
FLOW_RETENTION_BUSY_TIMEOUT_MS=5000
FLOW_RETENTION_GATE_MAX_AGE_MS=21600000
FLOW_RETENTION_TIMEOUT=1h
# COS is authoritative; retain only the most recent local daily archives (about 2-3 days).
FLOW_BACKUP_LOCAL_RETENTION_DAYS=2

# Smart-wallet monitoring remains research-only. It never triggers a live entry.
FLOW_SMART_WALLETS=Bi4rd5FH5bYEN8scZ7wevxNZyNmKHdaBcvewdPFxYdLt,7yd579zXmWPoxEE22BUYTzAo8nyMmQtPyEWS3g1BFhH4

# Smart Wallet pullback Shadow A/B. Both cohorts share the exact same simulated
# entry and never sign/send transactions. A exits on 7.5% peak drawdown; B on 12.5%.
# Historical rows remain visible; new A/B entries are stopped by default.
FLOW_SMART_PULLBACK_SHADOW_ENABLED=false
FLOW_SMART_PULLBACK_MIN_BUY_SOL=0.1
FLOW_SMART_PULLBACK_EPISODE_GAP_MS=30000
FLOW_SMART_PULLBACK_CONFIRMATION_WINDOW_MS=15000
FLOW_SMART_PULLBACK_DRAWDOWN_PCT=2.5
FLOW_SMART_PULLBACK_REBOUND_PCT=7.5
FLOW_SMART_PULLBACK_MIN_REBOUND_BUYERS=1
FLOW_SMART_PULLBACK_MAX_ENTRY_VS_SMART_PCT=2
FLOW_SMART_PULLBACK_MAX_CONFIRM_JUMP_PCT=10
FLOW_SMART_PULLBACK_POSITION_SOL=1
FLOW_SMART_PULLBACK_ENTRY_DELAY_MS=200
FLOW_SMART_PULLBACK_ENTRY_TIMEOUT_MS=2000
FLOW_SMART_PULLBACK_EXIT_DELAY_MS=200
FLOW_SMART_PULLBACK_EXIT_TIMEOUT_MS=5000
FLOW_SMART_PULLBACK_MAX_HOLD_MS=60000
FLOW_SMART_PULLBACK_A_TRAILING_STOP_PCT=7.5
FLOW_SMART_PULLBACK_B_TRAILING_STOP_PCT=12.5
FLOW_SMART_PULLBACK_BIG_WINNER_PCT=50

# Isolated true Smart Wallet OPEN Shadow D0/D1/D2 (never sends transactions)
FLOW_SMART_OPEN_SHADOW_ENABLED=false
FLOW_SMART_OPEN_SHADOW_MIN_SOL=1
FLOW_SMART_OPEN_SHADOW_PREBUY_WINDOW_MS=2000
FLOW_SMART_OPEN_SHADOW_MIN_PREBUY_BUYERS=2
FLOW_SMART_OPEN_SHADOW_MAX_ENTRY_JUMP_PCT=10
FLOW_SMART_OPEN_SHADOW_POSITION_SOL=1
FLOW_SMART_OPEN_SHADOW_ENTRY_DELAY_MS=200
FLOW_SMART_OPEN_SHADOW_ENTRY_TIMEOUT_MS=2000
FLOW_SMART_OPEN_SHADOW_EXIT_DELAY_MS=200
FLOW_SMART_OPEN_SHADOW_EXIT_TIMEOUT_MS=5000
FLOW_SMART_OPEN_SHADOW_D0_HOLD_MS=5000
FLOW_SMART_OPEN_SHADOW_D1_HARD_STOP_PCT=12.5
FLOW_SMART_OPEN_SHADOW_D1_TRAILING_ACTIVATION_PCT=20
FLOW_SMART_OPEN_SHADOW_D1_TRAILING_STOP_PCT=15
FLOW_SMART_OPEN_SHADOW_D1_MAX_HOLD_MS=60000
FLOW_SMART_OPEN_SHADOW_D2_HARD_STOP_PCT=12.5
FLOW_SMART_OPEN_SHADOW_D2_MAX_HOLD_MS=180000
FLOW_SMART_OPEN_SHADOW_BIG_WINNER_PCT=50

# Forward-only Flow -> Smart confirmation Shadow L. It waits for a monitored
# wallet OPEN and then enters on a later trade; it never backfills the Flow price.
FLOW_SMART_CONFIRM_SHADOW_ENABLED=true
FLOW_SMART_CONFIRM_SHADOW_POSITION_SOL=1
FLOW_SMART_CONFIRM_SHADOW_MIN_OPEN_SOL=0.1
FLOW_SMART_CONFIRM_SHADOW_ENTRY_DELAY_MS=200
FLOW_SMART_CONFIRM_SHADOW_ENTRY_TIMEOUT_MS=2000
FLOW_SMART_CONFIRM_SHADOW_EXIT_DELAY_MS=200
FLOW_SMART_CONFIRM_SHADOW_EXIT_TIMEOUT_MS=5000
FLOW_SMART_CONFIRM_SHADOW_MAX_ENTRY_JUMP_PCT=10
FLOW_SMART_CONFIRM_SHADOW_BIG_WINNER_PCT=50

# Isolated Launch first-pullback Shadow F1/F2/F3 (never sends transactions)
# Reference structure comes from Observer E: +25% pump / 7.5% pullback / 3% rebound.
FLOW_LAUNCH_PULLBACK_SHADOW_ENABLED=true
FLOW_LAUNCH_PULLBACK_SHADOW_POSITION_SOL=1
FLOW_LAUNCH_PULLBACK_SHADOW_ENTRY_DELAY_MS=200
FLOW_LAUNCH_PULLBACK_SHADOW_ENTRY_TIMEOUT_MS=2000
FLOW_LAUNCH_PULLBACK_SHADOW_EXIT_DELAY_MS=200
FLOW_LAUNCH_PULLBACK_SHADOW_EXIT_TIMEOUT_MS=5000
FLOW_LAUNCH_PULLBACK_SHADOW_MAX_ENTRY_JUMP_PCT=10
FLOW_LAUNCH_PULLBACK_SHADOW_HOLD_3S_MS=3000
FLOW_LAUNCH_PULLBACK_SHADOW_HOLD_8S_MS=8000
FLOW_LAUNCH_PULLBACK_F1_MIN_NET_FLOW_SOL=15
FLOW_LAUNCH_PULLBACK_F1_MAX_CREATOR_SHARE_PCT=5
FLOW_LAUNCH_PULLBACK_F2_MIN_NET_FLOW_SOL=20
FLOW_LAUNCH_PULLBACK_F2_MAX_CREATOR_SHARE_PCT=10
# Forward-only F2 optimization cohorts. Existing F2/FT-C cohorts keep their IDs
# and thresholds; these independent cohorts require stronger reference flow.
FLOW_LAUNCH_PULLBACK_NF30_MIN_NET_FLOW_SOL=30
# Independent causal-quality cohorts. They keep the F2 reference unchanged and
# freeze peak sell pressure, buy refill and 1-second re-acceleration at signal time.
FLOW_LAUNCH_PULLBACK_ABSORB3_MIN_SELL_SOL=3
FLOW_LAUNCH_PULLBACK_ABSORB5_MIN_SELL_SOL=5
FLOW_LAUNCH_PULLBACK_MIN_BUY_REFILL_RATIO=0.5
FLOW_LAUNCH_PULLBACK_REACCEL_MIN_NET_FLOW_1S_SOL=0
FLOW_LAUNCH_PULLBACK_REACCEL_MIN_ACCEL_1S_SOL=0
FLOW_LAUNCH_PULLBACK_F3_MIN_NET_FLOW_SOL=20
FLOW_LAUNCH_PULLBACK_F3_MAX_CREATOR_SHARE_PCT=20
# Forward-only FC cohorts require a Flow signal that already existed in the
# five seconds before the pullback reference and had BuyersW3 >= 3. Disabling
# this switch stops only new FC rows; all existing F/FT/FD/FO history remains.
FLOW_LAUNCH_FLOW_CONSENSUS_ENABLED=true
# Independent extended-hold cohorts found by the historical exit grid.
# FT-A has no hard stop; FT-B/C/D use the configured 30% hard stop.
FLOW_LAUNCH_PULLBACK_FT_A_ACTIVATION_PCT=0
FLOW_LAUNCH_PULLBACK_FT_A_DRAWDOWN_PCT=20
FLOW_LAUNCH_PULLBACK_FT_A_MIN_HOLD_MS=3000
FLOW_LAUNCH_PULLBACK_FT_A_MAX_HOLD_MS=120000
FLOW_LAUNCH_PULLBACK_FT_B_ACTIVATION_PCT=10
FLOW_LAUNCH_PULLBACK_FT_B_DRAWDOWN_PCT=20
FLOW_LAUNCH_PULLBACK_FT_B_MIN_HOLD_MS=3000
FLOW_LAUNCH_PULLBACK_FT_B_MAX_HOLD_MS=120000
FLOW_LAUNCH_PULLBACK_FT_B_HARD_STOP_PCT=30
FLOW_LAUNCH_PULLBACK_FT_C_ACTIVATION_PCT=30
FLOW_LAUNCH_PULLBACK_FT_C_DRAWDOWN_PCT=20
FLOW_LAUNCH_PULLBACK_FT_C_MIN_HOLD_MS=0
FLOW_LAUNCH_PULLBACK_FT_C_MAX_HOLD_MS=120000
FLOW_LAUNCH_PULLBACK_FT_C_HARD_STOP_PCT=30
FLOW_LAUNCH_PULLBACK_FT_D_ACTIVATION_PCT=30
FLOW_LAUNCH_PULLBACK_FT_D_DRAWDOWN_PCT=15
FLOW_LAUNCH_PULLBACK_FT_D_MIN_HOLD_MS=3000
FLOW_LAUNCH_PULLBACK_FT_D_MAX_HOLD_MS=120000
FLOW_LAUNCH_PULLBACK_FT_D_HARD_STOP_PCT=30
# Forward-only deep-pullback entry cohorts. Existing F/FT history is unchanged.
# FD10-R3 / FD12.5-R3 use a 500ms stable low; FD12.5-R5 / FD15-R5 use 1000ms.
FLOW_LAUNCH_DEEP_D10_R3_PULLBACK_PCT=10
FLOW_LAUNCH_DEEP_D10_R3_REBOUND_PCT=3
FLOW_LAUNCH_DEEP_D10_R3_LOW_STABLE_MS=500
FLOW_LAUNCH_DEEP_D12_5_R3_PULLBACK_PCT=12.5
FLOW_LAUNCH_DEEP_D12_5_R3_REBOUND_PCT=3
FLOW_LAUNCH_DEEP_D12_5_R3_LOW_STABLE_MS=500
FLOW_LAUNCH_DEEP_D12_5_R5_PULLBACK_PCT=12.5
FLOW_LAUNCH_DEEP_D12_5_R5_REBOUND_PCT=5
FLOW_LAUNCH_DEEP_D12_5_R5_LOW_STABLE_MS=1000
FLOW_LAUNCH_DEEP_D15_R5_PULLBACK_PCT=15
FLOW_LAUNCH_DEEP_D15_R5_REBOUND_PCT=5
FLOW_LAUNCH_DEEP_D15_R5_LOW_STABLE_MS=1000
FLOW_LAUNCH_DEEP_MIN_NEW_BUYERS=2
FLOW_LAUNCH_DEEP_FLOW_WINDOW_MS=1000
FLOW_LAUNCH_DEEP_MIN_WINDOW_NET_FLOW_SOL=0.01
FLOW_LAUNCH_DEEP_MAX_PULLBACK_PCT=25
FLOW_LAUNCH_DEEP_MIN_NET_FLOW_SOL=15
FLOW_LAUNCH_DEEP_MAX_CREATOR_SHARE_PCT=5
FLOW_LAUNCH_DEEP_FIXED_HOLD_MS=5000
# Forward-only D12.5/R3 quality cohorts. Q and QC keep separate cohort IDs;
# the original FO_D12_R3_10S history and rules remain unchanged.
FLOW_LAUNCH_D12_QUALITY_MIN_NET_FLOW_SOL=15
FLOW_LAUNCH_D12_QUALITY_MAX_NET_FLOW_SOL=50
FLOW_LAUNCH_D12_QUALITY_MIN_RETENTION_PCT=70
FLOW_LAUNCH_D12_QUALITY_MAX_TOP3_SHARE_PCT=50
FLOW_LAUNCH_D12_QUALITY_MAX_CREATOR_SHARE_PCT=5
FLOW_LAUNCH_D12_STRICT_MAX_CREATOR_SHARE_PCT=3
FLOW_LAUNCH_D12_QUALITY_FIXED_HOLD_MS=10000
FLOW_LAUNCH_D12_QUALITY_TRAILING_ACTIVATION_PCT=20
FLOW_LAUNCH_D12_QUALITY_TRAILING_DRAWDOWN_PCT=10
FLOW_LAUNCH_D12_QUALITY_HARD_STOP_PCT=20
FLOW_LAUNCH_D12_QUALITY_TRAILING_MAX_HOLD_MS=30000

FLOW_LAUNCH_PULLBACK_SHADOW_BIG_WINNER_PCT=50

# Observational market-regime labels only. These settled 30-minute breadth
# values are stored with each new sample and never gate an entry.
FLOW_LAUNCH_MARKET_REGIME_LOOKBACK_MS=1800000
FLOW_LAUNCH_MARKET_REGIME_SETTLEMENT_LAG_MS=60000
FLOW_LAUNCH_MARKET_REGIME_CACHE_MS=5000

# Independent pre-migration Bonding Curve Momentum Shadow H. The four entry
# profiles and three exit profiles are fixed research cohorts in code.
FLOW_BONDING_MOMENTUM_SHADOW_ENABLED=false
FLOW_BONDING_MOMENTUM_POSITION_SOL=1
FLOW_BONDING_MOMENTUM_STATE_WINDOW_MS=5000
FLOW_BONDING_MOMENTUM_STATE_RETENTION_MS=60000
FLOW_BONDING_MOMENTUM_EPISODE_COOLDOWN_MS=5000
FLOW_BONDING_MOMENTUM_ENTRY_DELAY_MS=200
FLOW_BONDING_MOMENTUM_ENTRY_TIMEOUT_MS=2000
FLOW_BONDING_MOMENTUM_EXIT_DELAY_MS=200
FLOW_BONDING_MOMENTUM_EXIT_TIMEOUT_MS=5000
FLOW_BONDING_MOMENTUM_MAX_ENTRY_JUMP_PCT=10
FLOW_BONDING_MOMENTUM_SNAPSHOT_SECONDS=1,2,3,5,8,10,20,30
FLOW_BONDING_MOMENTUM_MAX_SNAPSHOT_LAG_MS=2000
FLOW_BONDING_MOMENTUM_FLOW_EXIT_NET_SOL=0
FLOW_BONDING_MOMENTUM_FLOW_EXIT_BUY_TX_ACCEL=0
FLOW_BONDING_MOMENTUM_FLOW_EXIT_MIN_SELL_SOL=0.5
FLOW_BONDING_MOMENTUM_FIXED_HOLD_MS=3000
FLOW_BONDING_MOMENTUM_FLOW_MIN_HOLD_MS=500
FLOW_BONDING_MOMENTUM_FLOW_MAX_HOLD_MS=10000
FLOW_BONDING_MOMENTUM_TRAIL_MIN_HOLD_MS=500
FLOW_BONDING_MOMENTUM_TRAIL_ACTIVATION_PCT=10
FLOW_BONDING_MOMENTUM_TRAIL_STOP_PCT=7.5
FLOW_BONDING_MOMENTUM_TRAIL_MAX_HOLD_MS=30000
FLOW_BONDING_MOMENTUM_BIG_WINNER_PCT=50

# Graduation Probability Hold Shadow I. Fresh entries only reuse early Primary
# Flow signals at Curve<=70%; I0/I1/I2 never sign or send a transaction.
FLOW_GRADUATION_HOLD_SHADOW_ENABLED=false
FLOW_GRADUATION_HOLD_POSITION_SOL=1
FLOW_GRADUATION_HOLD_MAX_SIGNAL_LATENCY_MS=1500
FLOW_GRADUATION_HOLD_MAX_ENTRY_CURVE_PCT=70
FLOW_GRADUATION_HOLD_MAX_TOKEN_AGE_MS=600000
FLOW_GRADUATION_HOLD_STATE_RETENTION_MS=600000
FLOW_GRADUATION_HOLD_ENTRY_DELAY_MS=200
FLOW_GRADUATION_HOLD_ENTRY_TIMEOUT_MS=2000
FLOW_GRADUATION_HOLD_EXIT_DELAY_MS=200
FLOW_GRADUATION_HOLD_EXIT_TIMEOUT_MS=5000
FLOW_GRADUATION_HOLD_MAX_ENTRY_JUMP_PCT=10
FLOW_GRADUATION_HOLD_HARD_STOP_PCT=30
FLOW_GRADUATION_HOLD_I0_TRAILING_STOP_PCT=7.5
FLOW_GRADUATION_HOLD_I0_MAX_HOLD_MS=60000
FLOW_GRADUATION_HOLD_MAX_HOLD_MS=120000
FLOW_GRADUATION_HOLD_FIRST_CHECKPOINT_TIMEOUT_MS=20000
FLOW_GRADUATION_HOLD_STEP_TIMEOUT_MS=3000
FLOW_GRADUATION_HOLD_GRADUATION_TIMEOUT_MS=15000
FLOW_GRADUATION_HOLD_I2_AMM_EXIT_DELAY_MS=5000
FLOW_GRADUATION_HOLD_I2_MIN_BUYERS_5S=12
FLOW_GRADUATION_HOLD_I2_MAX_CUMULATIVE_TRADES=20
FLOW_GRADUATION_HOLD_BIG_WINNER_PCT=50

# Graduation Acceleration Shadow O. Independent forward-only cohorts:
# FAST10 quality gate and Curve80 order-flow burst. Curve75/78 are independent
# early-entry comparisons; O_C80_M5_HANDOFF_X60 waits for graduation and uses
# the first five PumpSwap seconds as a Shadow-only entry gate. None of those
# new profiles bridge to live. Graduation exits and NO_EXIT semantics remain
# isolated per cohort; NO_EXIT stays NULL rather than -100%.
FLOW_GRADUATION_ACCEL_SHADOW_ENABLED=true
# Shadow capacity remains 1 SOL independently of the live order size.
FLOW_GRADUATION_ACCEL_V2_CAPACITY_SOLS=1
FLOW_GRADUATION_ACCEL_ENTRY_DELAY_MS=200
FLOW_GRADUATION_ACCEL_ENTRY_TIMEOUT_MS=2000
FLOW_GRADUATION_ACCEL_EXIT_DELAY_MS=200
FLOW_GRADUATION_ACCEL_EXIT_TIMEOUT_MS=15000
FLOW_GRADUATION_ACCEL_MAX_ENTRY_JUMP_PCT=15
FLOW_GRADUATION_ACCEL_HARD_STOP_PCT=30
FLOW_GRADUATION_ACCEL_MAX_PRE_GRAD_HOLD_MS=300000
FLOW_GRADUATION_ACCEL_MAX_POST_GRAD_HOLD_MS=300000
FLOW_GRADUATION_ACCEL_CORE_EXIT_PCT=50
FLOW_GRADUATION_ACCEL_BIG_WINNER_PCT=50
# Shadow-only counterfactuals for O-C80 failed-entry analysis. They never bridge
# to LiveTradingManager: HO0/200/500 wait for executable PumpSwap handoff, while
# J40-50/J50-60/J60-70 isolate the first curve repricing band after the signal.
# Each cohort uses reserve-aware entry/exit prices at both 0.1 and 1 SOL capacity.
FLOW_GRADUATION_ACCEL_RELAXED_ENTRY_SHADOW_ENABLED=true
FLOW_GRADUATION_ACCEL_RELAXED_CAPACITY_SOLS=0.1,1
# O90_M5 cohorts are fixed forward-only profiles in code: first Curve>=90%,
# DeltaCurve5>=5%, Buyers5>=1, SellTx5<=1 and no creator sell. Graduation sells
# 50% core; the runner survives only when the first PumpSwap 5s has >=25 buyers
# and non-negative net flow. Fixed 60s/120s and tiered-120s exits are isolated.
# Additional forward-only O cohorts are also fixed in code and have no live
# bridge: O90_Q70_D30_X60/STAIR120 require Buyers5>=3, NetFlow5>=70 SOL and
# DeltaCurve5>=30%; O90_DAY0818, O_C80_DAY1218, O_C80_NIGHT0004 and
# O_C80_EVENING2024 only label Beijing-time sessions. O_C75/O_C78 compare
# whether an earlier curve trigger reduces
# migration-before-submit misses. O_C80_M5_HANDOFF_X60 requires >=5 PumpSwap
# buyers, non-negative net flow, Sell/Buy<=0.7, <=20% drawdown, <=15% market
# move and <=10% 1 SOL self-impact before a 60s fixed-hold Shadow entry.
# All new cohorts use a capacity-aware 1 SOL simulated exit.

# Lifecycle oversold-rebound Shadow G: pre-migration Curve and post-migration
# PumpSwap are separate cohorts and never send transactions. The online matrix
# is fixed in code; these values control state retention and simulated execution.
FLOW_MIGRATED_REBOUND_SHADOW_ENABLED=true
