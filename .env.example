FLOW_PRE_ENTRY_RUG_RISK_MIN_TRADES=10
FLOW_PRE_ENTRY_RUG_RISK_MIN_BUY_SHARE_PCT=58
FLOW_PRE_ENTRY_RUG_RISK_MIN_BUY_STREAK=14
FLOW_PRE_ENTRY_RUG_RISK_MAX_ALTERNATION_PCT=30
FLOW_PRE_ENTRY_RUG_RISK_MIN_UPTICK_PCT=55
FLOW_PRE_ENTRY_RUG_RISK_MIN_RETURN_PCT=30
FLOW_PRE_ENTRY_RUG_RISK_MIN_FLAGS=5
FLOW_PRE_ENTRY_RUG_RISK_VERTICAL_MIN_RETURN_PCT=50
FLOW_PRE_ENTRY_RUG_RISK_VERTICAL_MIN_BUY_IMPACT_PCT=10
FLOW_PRE_ENTRY_RUG_RISK_VERTICAL_MIN_WALLET_TX_SHARE_PCT=8
FLOW_PRE_ENTRY_RUG_RISK_SPARSE_MIN_BUYS_PER_BUYER=2
FLOW_PRE_ENTRY_RUG_RISK_REPEAT_MIN_RETURN_PCT=30
FLOW_PRE_ENTRY_RUG_RISK_REPEAT_MIN_SIZE_SHARE_PCT=15
FLOW_PRE_ENTRY_RUG_RISK_BEIJING_WINDOW_ENABLED=true
FLOW_PRE_ENTRY_RUG_RISK_BEIJING_START_HOUR=16
FLOW_PRE_ENTRY_RUG_RISK_BEIJING_END_HOUR=20
FLOW_PRE_ENTRY_RUG_RISK_BEIJING_MIN_FLAGS=4
# Cross-Mint toxic launch template memory. It learns only after an observed
# >=60% collapse, then blocks later matching amount/timing templates or >=2
# learned wallets. The live entry path remains memory-only (no RPC / no DB).
FLOW_PRE_ENTRY_RUG_CROSS_MINT_ENABLED=true
FLOW_PRE_ENTRY_RUG_TEMPLATE_WINDOW_MS=5000
FLOW_PRE_ENTRY_RUG_TEMPLATE_LARGE_BUY_MIN_SOL=1
FLOW_PRE_ENTRY_RUG_TEMPLATE_MIN_LARGE_BUYS=4
FLOW_PRE_ENTRY_RUG_TEMPLATE_MAX_LARGE_BUYS=6
FLOW_PRE_ENTRY_RUG_TEMPLATE_MIN_TOTAL_BUY_SOL=40
FLOW_PRE_ENTRY_RUG_TEMPLATE_MAX_BURST_SPAN_MS=500
FLOW_PRE_ENTRY_RUG_TEMPLATE_SIZE_BUCKET_SOL=0.25
FLOW_PRE_ENTRY_RUG_TOXIC_COLLAPSE_PCT=60
FLOW_PRE_ENTRY_RUG_TOXIC_COLLAPSE_WINDOW_MS=30000
FLOW_PRE_ENTRY_RUG_TOXIC_RETENTION_MS=86400000
FLOW_PRE_ENTRY_RUG_TOXIC_MEMORY_PATH=./data/pre-entry-rug-toxic-memory.json
FLOW_PRE_ENTRY_RUG_TOXIC_PERSIST_INTERVAL_MS=5000
FLOW_PRE_ENTRY_RUG_TOXIC_AMOUNT_TOLERANCE_PCT=2
FLOW_PRE_ENTRY_RUG_TOXIC_BURST_TOLERANCE_MS=100
FLOW_PRE_ENTRY_RUG_TOXIC_WALLET_OVERLAP_MIN=2
FLOW_PRE_ENTRY_RUG_MAX_TOXIC_WALLETS=4096
FLOW_PRE_ENTRY_RUG_MAX_TOXIC_TEMPLATES=1024

# Big Winner Pullback + Flow + Participation Persistence Shadow.
# PP cohorts use the first 10s post-migration participation breadth, then compare
# direct entry with an 8-20/30% first pullback + renewed-flow entry. Each PP row
# is isolated by 0.05/0.1/0.25 SOL capacity and never sends an RPC quote or transaction.
# Historical BW/PP/PBR rows remain queryable. New forward rows are restricted to
# PP20_B45 and PP20_QUALITY; proven-negative PBR-C is paused again.
FLOW_BIG_WINNER_SHADOW_V3_ENABLED=true
FLOW_BIG_WINNER_SHADOW_POSITION_SOL=1
FLOW_BIG_WINNER_SHADOW_STATE_WINDOW_MS=10000
FLOW_BIG_WINNER_SHADOW_STATE_RETENTION_MS=600000
FLOW_BIG_WINNER_SHADOW_ENTRY_DELAY_MS=200
FLOW_BIG_WINNER_SHADOW_ENTRY_TIMEOUT_MS=2000
FLOW_BIG_WINNER_SHADOW_NO_EXIT_GRACE_MS=60000
FLOW_BIG_WINNER_SHADOW_MAX_ENTRY_JUMP_PCT=50
FLOW_BIG_WINNER_SHADOW_MAX_ENTRY_DROP_PCT=50
FLOW_BIG_WINNER_SHADOW_MAX_ENTRY_IMPACT_PCT=40
FLOW_BIG_WINNER_SHADOW_MAX_PRICE_RATIO=20
# A single upward repricing >=2x is withheld from MFE/core-exit accounting until
# another independent wallet confirms it or it persists for 150ms. Downward
# moves remain immediate so RUG loss simulation is not softened.
FLOW_BIG_WINNER_SHADOW_TRANSIENT_UP_PRICE_RATIO=2
FLOW_BIG_WINNER_SHADOW_PRICE_CONFIRMATION_WINDOW_MS=500
FLOW_BIG_WINNER_SHADOW_PRICE_CONFIRMATION_MIN_PERSISTENCE_MS=150
FLOW_BIG_WINNER_SHADOW_PRICE_CONFIRMATION_TOLERANCE_PCT=25
FLOW_BIG_WINNER_SHADOW_PRICE_CONFIRMATION_MIN_WALLETS=2
FLOW_BIG_WINNER_PP_CAPACITY_SOLS=0.05,0.1,0.25
# Forward-only PP8-30-NF8-3 cohorts. Keep 0.1 and 0.25 SOL isolated so
# execution-capacity results are never blended with the legacy PP samples.
FLOW_BIG_WINNER_PP_NF8_CAPACITY_SOLS=0.1,0.25
# A signed entry that expired by block height is checked again after this grace
# period. It is released only when signature history, transaction metadata and
# the wallet receipt remain absent; confirmed or ambiguous receipts stay guarded.
FLOW_LIVE_EXPIRED_ENTRY_RELEASE_MS=600000

# Real signing (only read when ENABLED=true and DRY_RUN=false).
FLOW_RPC_URL=
# Optional HTTP RPC in another endpoint/region. It is used only when the primary
# RPC cannot satisfy the gRPC signal slot after the configured synchronized reads.
FLOW_LIVE_CONTEXT_FALLBACK_RPC_URL=
FLOW_LIVE_PRIVATE_KEY=
# Quote and preflight must use the same newest state as the processed gRPC stream.
# Final position state still waits for confirmed-level transaction confirmation.
FLOW_LIVE_READ_COMMITMENT=processed
FLOW_LIVE_CONFIRMATION_COMMITMENT=confirmed
FLOW_LIVE_CONTEXT_SLOT_RETRIES=6
FLOW_LIVE_CONTEXT_SLOT_RETRY_DELAY_MS=50
# FLOW_LIVE_COMMITMENT remains a legacy fallback for CONFIRMATION_COMMITMENT.
# Creating this file immediately blocks new entries. Existing exit logic remains active.
FLOW_LIVE_KILL_SWITCH_FILE=./data/LIVE_TRADING_DISABLED

