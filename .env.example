# CYA Organic Burst Shadow COB. This is an independent forward-only strategy,
# not a continuation of CSF/K. Public order flow alone creates a signal; all
# monitored Smart Wallet trades are excluded and CYA OPEN is a future label.
# COB-A/B/C are retained for history and active-position recovery, but no longer
# create entries. Forward data is collected only by mutually exclusive COB-D/F:
# 2-10s, Buyers5>=10, NetFlow5>=5/7 SOL, Buy share 70-95%, Return2s 0-40%
# and Drawdown15>=2%. F has priority when NetFlow5>=7. Each strict entry is
# crossed with FIX30, FLOWFADE_X60, T30_10_X60 and CORE25_R75_X120 exits.
# Every cohort uses a reserve-priced 1 SOL fill and 200ms entry/exit delay.
FLOW_CYA_ORGANIC_BURST_SHADOW_ENABLED=true
FLOW_CYA_ORGANIC_BURST_TARGET_WALLET=CyaE1VxvBrahnPWkqm5VsdCvyS2QmNht2UFrKJHga54o
FLOW_CYA_ORGANIC_BURST_POSITION_SOL=1
FLOW_CYA_ORGANIC_BURST_FEATURE_WINDOW_MS=15000
FLOW_CYA_ORGANIC_BURST_MAX_TRADES_PER_MINT=256
FLOW_CYA_ORGANIC_BURST_STATE_RETENTION_MS=600000
FLOW_CYA_ORGANIC_BURST_EPISODE_COOLDOWN_MS=600000
FLOW_CYA_ORGANIC_BURST_TARGET_LABEL_WINDOW_MS=15000
FLOW_CYA_ORGANIC_BURST_ENTRY_DELAY_MS=200
FLOW_CYA_ORGANIC_BURST_ENTRY_TIMEOUT_MS=2000
FLOW_CYA_ORGANIC_BURST_EXIT_DELAY_MS=200
FLOW_CYA_ORGANIC_BURST_EXIT_TIMEOUT_MS=5000
FLOW_CYA_ORGANIC_BURST_MAX_ENTRY_JUMP_PCT=35
FLOW_CYA_ORGANIC_BURST_MAX_ENTRY_DROP_PCT=35
FLOW_CYA_ORGANIC_BURST_MAX_ENTRY_IMPACT_PCT=25
FLOW_CYA_ORGANIC_BURST_LIVE_REPLAY_ENABLED=true
FLOW_CYA_ORGANIC_BURST_LIVE_REPLAY_POSITION_SOL=0.1
FLOW_CYA_ORGANIC_BURST_LIVE_REPLAY_ENTRY_DELAY_MS=200
FLOW_CYA_ORGANIC_BURST_LIVE_REPLAY_ENTRY_TIMEOUT_MS=1500
FLOW_CYA_ORGANIC_BURST_LIVE_REPLAY_MAX_ENTRY_JUMP_PCT=15
FLOW_CYA_ORGANIC_BURST_LIVE_REPLAY_MAX_ENTRY_DROP_PCT=35
FLOW_CYA_ORGANIC_BURST_LIVE_REPLAY_MAX_ENTRY_IMPACT_PCT=10

# Same-Slot Dump Backrun Shadow SDBR. The sell event's post-trade PumpSwap
# reserves are used for a theoretical immediate 0.1 SOL fill. It records the
# first following external BUY, whether that BUY is in the same slot, and
# 250/500/1000/2000ms exits. It never signs, sends, or adds RPC requests.
# Deprecated and ignored: SDBR is permanently retired in code. Historical
# rows and the Dashboard/API remain available, but this flag cannot reopen it.
FLOW_SAME_SLOT_DUMP_BACKRUN_SHADOW_ENABLED=false
FLOW_SAME_SLOT_DUMP_BACKRUN_POSITION_SOL=0.1
FLOW_SAME_SLOT_DUMP_BACKRUN_TRACKING_AGE_MS=900000
FLOW_SAME_SLOT_DUMP_BACKRUN_STATE_RETENTION_MS=1200000
FLOW_SAME_SLOT_DUMP_BACKRUN_EPISODE_COOLDOWN_MS=10000
FLOW_SAME_SLOT_DUMP_BACKRUN_EXIT_GRACE_MS=2000
FLOW_SAME_SLOT_DUMP_BACKRUN_MAX_EPISODES_PER_MINT=20

# Forward-only public order-flow RUG guard shared by every entry-capable Live and
# Shadow strategy. It performs no RPC or DB calls on the entry path.
FLOW_PRE_ENTRY_RUG_RISK_ENABLED=true
FLOW_PRE_ENTRY_RUG_RISK_WINDOW_MS=15000
FLOW_PRE_ENTRY_RUG_RISK_RETENTION_MS=60000
FLOW_PRE_ENTRY_RUG_RISK_SWEEP_MS=5000
