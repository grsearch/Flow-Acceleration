FLOW_SMART_CONFIRM_SHADOW_MAX_ENTRY_JUMP_PCT=10
FLOW_SMART_CONFIRM_SHADOW_BIG_WINNER_PCT=50

# Isolated Launch first-pullback Shadow F1/F2/F3 (never sends transactions)
# Reference structure comes from Observer E: +25% pump / 7.5% pullback / 3% rebound.
FLOW_LAUNCH_PULLBACK_SHADOW_ENABLED=true
FLOW_LAUNCH_PULLBACK_SHADOW_POSITION_SOL=1
FLOW_LAUNCH_PULLBACK_SHADOW_ENTRY_DELAY_MS=200
