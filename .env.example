# PumpSwap Range Scalper Shadow J. Every graduated mint is observed for two
# minutes; only high-volume, low-trend oscillating ranges keep a subscription
# for up to 20 minutes. JA/JB/JC remain unchanged. JW uses JB conditions, warms
# on opportunity 1, then trades opportunities 2/3 with X6 only.
FLOW_RANGE_SCALPER_SHADOW_ENABLED=true
FLOW_RANGE_SCALPER_POSITION_SOL=1
FLOW_RANGE_SCALPER_INITIAL_OBSERVATION_MS=120000
FLOW_RANGE_SCALPER_MAX_TRACKING_MS=1200000
FLOW_RANGE_SCALPER_WINDOW_MS=60000
FLOW_RANGE_SCALPER_RECENT_FLOW_MS=1000
FLOW_RANGE_SCALPER_RANGE_LOSS_CONFIRM_MS=30000
FLOW_RANGE_SCALPER_UNSUBSCRIBE_GRACE_MS=5000
FLOW_RANGE_SCALPER_MIN_TRADES=60
FLOW_RANGE_SCALPER_MIN_VOLUME_SOL=20
FLOW_RANGE_SCALPER_MIN_UNIQUE_WALLETS=20
FLOW_RANGE_SCALPER_MIN_BUY_SHARE_PCT=35
FLOW_RANGE_SCALPER_MAX_BUY_SHARE_PCT=65
FLOW_RANGE_SCALPER_MIN_RANGE_PCT=12
FLOW_RANGE_SCALPER_MAX_EFFICIENCY_RATIO=0.35
FLOW_RANGE_SCALPER_MIN_MEAN_CROSSES=4
FLOW_RANGE_SCALPER_MAX_TOP_WALLET_SHARE_PCT=25
FLOW_RANGE_SCALPER_MAX_TREND_PCT=12
FLOW_RANGE_SCALPER_MIN_RANGE_SCORE=65
FLOW_RANGE_SCALPER_ENTRY_DELAY_MS=200
FLOW_RANGE_SCALPER_ENTRY_TIMEOUT_MS=2000
FLOW_RANGE_SCALPER_EXIT_DELAY_MS=200
FLOW_RANGE_SCALPER_EXIT_TIMEOUT_MS=5000
FLOW_RANGE_SCALPER_MAX_ENTRY_JUMP_PCT=3
# Reject a simulated fill that collapsed far below the signal during the 200ms delay.
FLOW_RANGE_SCALPER_MAX_ENTRY_DROP_PCT=50
# Quarantine impossible adjacent-price scale changes without clipping legitimate big winners.
FLOW_RANGE_SCALPER_MAX_PRICE_SCALE_RATIO=100

# Observer-only Launch Quality / First Pullback research. These percentages are
# reference labels for feature collection, never trading or simulated-entry rules.
FLOW_LAUNCH_QUALITY_OBSERVER_ENABLED=true
FLOW_LAUNCH_QUALITY_SNAPSHOT_SECONDS=5,10,20,30,60
FLOW_LAUNCH_QUALITY_MAX_AGE_MS=90000
FLOW_LAUNCH_QUALITY_PUMP_REFERENCE_PCT=25
FLOW_LAUNCH_QUALITY_PULLBACK_REFERENCE_PCT=7.5
FLOW_LAUNCH_QUALITY_REBOUND_REFERENCE_PCT=3
FLOW_LAUNCH_QUALITY_RECENT_BUYER_WINDOW_MS=10000
FLOW_LAUNCH_QUALITY_RETENTION_FLOOR_PCT=10
FLOW_LAUNCH_QUALITY_MAX_OBSERVATION_LAG_MS=2000

# Live entry rule: the first post-migration PumpSwap 1-second 25-35% drop that
# rebounds 2-5% within one second. Research collection remains unchanged.
# Disabled: observe and store decisions only. DRY_RUN: simulate positions without signing.
# Safety lock defaults to true in code and overrides an old server .env that still
# has ENABLED=true. Keep it true during the Smart Pullback A/B research phase.
FLOW_LIVE_TRADING_SAFETY_LOCK=true
FLOW_LIVE_TRADING_ENABLED=false
FLOW_LIVE_DRY_RUN=true
FLOW_LIVE_MAX_SIGNAL_AGE_MS=1500

# Active live strategy: post-migration PumpSwap deep-drop rebound + XLEG.
# A real deployment must explicitly set its per-strategy SOL amount.
FLOW_LIVE_POST_GD25_35_XLEG_ENABLED=true
FLOW_LIVE_POST_GD25_35_XLEG_POSITION_SOL=1
FLOW_LIVE_POST_GD25_35_TRACKING_MS=120000
FLOW_LIVE_POST_GD25_35_WINDOW_MS=1000
FLOW_LIVE_POST_GD25_35_DROP_MIN_PCT=25
FLOW_LIVE_POST_GD25_35_DROP_MAX_PCT=35
FLOW_LIVE_POST_GD25_35_REBOUND_MIN_PCT=2
FLOW_LIVE_POST_GD25_35_REBOUND_MAX_PCT=5
FLOW_LIVE_POST_GD25_35_REBOUND_TIMEOUT_MS=1000
FLOW_LIVE_POST_GD25_35_MAX_ENTRY_JUMP_PCT=15
FLOW_LIVE_POST_GD25_35_TRAILING_ACTIVATION_PCT=8
FLOW_LIVE_POST_GD25_35_TRAILING_STOP_PCT=3
FLOW_LIVE_POST_GD25_35_FAST_TP_PCT=18
FLOW_LIVE_POST_GD25_35_FAST_TP_WINDOW_MS=5000
FLOW_LIVE_POST_GD25_35_LOSS_CHECK_MS=6000
FLOW_LIVE_POST_GD25_35_MAX_HOLD_MS=15000
FLOW_LIVE_MAX_POSITIONS=3
FLOW_LIVE_MIN_WALLET_RESERVE_SOL=0.05
FLOW_LIVE_MINT_COOLDOWN_MS=600000
# Fixed-input buy: position SOL is a hard spend cap. This percentage reduces
# minimum tokens received; it no longer permits spending above POSITION_SOL.
FLOW_LIVE_BUY_SLIPPAGE_PCT=10
FLOW_LIVE_SELL_SLIPPAGE_PCT=15
FLOW_LIVE_COMPUTE_UNIT_LIMIT=250000
# Total priority fee target per BUY or SELL transaction. The program converts
# this to micro-lamports/CU from FLOW_LIVE_COMPUTE_UNIT_LIMIT.
FLOW_LIVE_PRIORITY_FEE_SOL=0.0005

# Live XLEG exit: take +18% during the first 5 seconds; otherwise arm trailing at
# +8% and sell on a 3% peak drawdown. Exit a losing position at 6 seconds and
# force-close any remainder at 15 seconds.
# There is no daily trade-count cap or daily-loss stop in this test release.
# The emergency kill-switch file and wallet reserve guard remain active.
FLOW_LIVE_EXIT_RETRY_COUNT=10
FLOW_LIVE_EXIT_RETRY_DELAY_MS=1000
FLOW_LIVE_ENTRY_RECONCILE_COUNT=5
FLOW_LIVE_ENTRY_RECONCILE_DELAY_MS=1000

# Real signing (only read when ENABLED=true and DRY_RUN=false).
FLOW_RPC_URL=
FLOW_LIVE_PRIVATE_KEY=
# Quote and preflight must use the same newest state as the processed gRPC stream.
# Final position state still waits for confirmed-level transaction confirmation.
FLOW_LIVE_READ_COMMITMENT=processed
FLOW_LIVE_CONFIRMATION_COMMITMENT=confirmed
FLOW_LIVE_CONTEXT_SLOT_RETRIES=2
FLOW_LIVE_CONTEXT_SLOT_RETRY_DELAY_MS=25
# FLOW_LIVE_COMMITMENT remains a legacy fallback for CONFIRMATION_COMMITMENT.
# Creating this file immediately blocks new entries. Existing exit logic remains active.
FLOW_LIVE_KILL_SWITCH_FILE=./data/LIVE_TRADING_DISABLED

# Read-only research dashboard.
FLOW_DASHBOARD_PORT=3001
FLOW_BIND_HOST=0.0.0.0
